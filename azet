#!/bin/sh
# azet — AI coding agent on AZET AI API (https://api.azet.io). First run needs no key: it takes a free trial key.
# The agent is our build of Pi (MIT, https://github.com/earendil-works/pi), shipped next to this script as azet-agent/.
set -eu
VERSION=0.5.0
HERE=$(cd "$(dirname "$0")" && pwd -P)
PI="${AZET_PI:-$HERE/azet-agent/azet-agent}"
case "${1:-}" in
  -v|--version) echo "azet $VERSION"; exit 0 ;;
  -h|--help) cat <<'EOF'
azet - AI coding agent in your terminal (AZET LLC)

  azet                  start in the current folder
  azet "task"           start with a first message
  azet -p "task"        run once, print the answer, exit
  azet --model <id>     pick a model (deepseek-v4.1-flash, moonshotai/Kimi-K2.6, deepseek-v4-pro-0813)
  azet --continue       continue the last session here
  azet --no-sandbox     let commands write outside this folder (or AZET_SANDBOX=0)

Sandbox (on by default, macOS): the agent can write only inside the folder you
started it in, ~/.config/azet, temp folders and package caches, and cannot read
~/.ssh, ~/.aws, other logins, the keychain or .env files. Started in your home
folder or /, azet asks for a work folder first.
Shell commands that delete files, push or publish, send data off this machine,
or use sudo ask before they run (and are blocked in -p mode).
Key: AZET_API_KEY or ~/.config/azet/key. Credit: https://api.azet.io/#credits
Docs: https://azet-llc.github.io/azet-cli/  ·  Agent: our build of Pi (MIT) - all flags: azet --help-all
EOF
    exit 0 ;;
  --help-all) exec "$PI" --help ;;  # needs no key
esac
# The agent may write anywhere under the folder it starts in, so not in your home folder or /: pick a work folder.
HOMEP=$(cd "$HOME" && pwd -P)
if [ "$(pwd -P)" = "$HOMEP" ] || [ "$(pwd -P)" = / ]; then
  printf 'azet: you are in %s. Started here, the agent could change any file in it.\n' "$(pwd -P)" >&2
  if [ ! -t 0 ] || [ ! -t 2 ]; then
    printf 'azet: cd into a project folder first, e.g. mkdir -p ~/azet-work && cd ~/azet-work\n' >&2; exit 1
  fi
  printf 'azet: folder to work in (Enter = ~/azet-work): ' >&2
  read -r D || D=
  case "$D" in "") D="$HOME/azet-work" ;; "~") D="$HOME" ;; "~/"*) D="$HOME/${D#\~/}" ;; esac
  mkdir -p "$D" && cd "$D" || exit 1
  if [ "$(pwd -P)" = "$HOMEP" ] || [ "$(pwd -P)" = / ]; then printf 'azet: pick a folder inside your home folder\n' >&2; exit 1; fi
  printf 'azet: working in %s\n' "$(pwd -P)" >&2
fi

API="${AZET_API_BASE:-https://api.azet.io}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/azet"   # same key file as `npx azet-ai login`

KEY="${AZET_API_KEY:-}"
[ -n "$KEY" ] || KEY=$(cat "$CFG/key" 2>/dev/null || true)
if [ -z "$KEY" ]; then
  printf 'azet: getting your free trial credit from api.azet.io ...\n' >&2
  R=$(curl -sS -m 20 -X POST "$API/v1/trial" -H 'user-agent: azet-cli' || true)
  KEY=$(printf '%s' "$R" | grep -oE 'azk_[0-9a-f]{48}' | head -1 || true)
  if [ -z "$KEY" ]; then
    MSG=$(printf '%s' "$R" | sed -n 's/.*"message":"\([^"]*\)".*/\1/p')
    printf 'azet: %s\nazet: or use your own key: AZET_API_KEY=azk_... azet\n' "${MSG:-could not reach $API}" >&2
    exit 1
  fi
  mkdir -p "$CFG" && (umask 077 && printf '%s\n' "$KEY" > "$CFG/key")
  printf 'azet: free trial ready ($%s credit). Buy more any time: %s/#credits\n' \
    "$(printf '%s' "$R" | sed -n 's/.*"balance_usd":\([0-9.]*\).*/\1/p')" "$API" >&2
fi
export AZET_API_KEY="$KEY"

# The agent reads only our folder (~/.config/azet/agent) and a project's .azet/. Key stays in the env, not in the file.
AGENT="$CFG/agent"; mkdir -p "$AGENT"
cat > "$AGENT/models.json" <<EOF
{"providers":{"azet":{"name":"AZET","baseUrl":"$API/v1","api":"openai-completions","apiKey":"\$AZET_API_KEY",
 "compat":{"supportsDeveloperRole":false,"supportsStore":false,"maxTokensField":"max_tokens"},
 "models":[
  {"id":"deepseek-v4.1-flash","name":"DeepSeek V4.1 Flash","contextWindow":1000000,"maxTokens":16384,"cost":{"input":0.3,"output":1.2,"cacheRead":0.3,"cacheWrite":0.3}},
  {"id":"moonshotai/Kimi-K2.6","name":"Kimi K2.6","contextWindow":262144,"maxTokens":16384,"cost":{"input":0.95,"output":4.0,"cacheRead":0.95,"cacheWrite":0.95}},
  {"id":"deepseek-v4-pro-0813","name":"DeepSeek V4 Pro","contextWindow":1000000,"maxTokens":16384,"cost":{"input":1.32,"output":3.96,"cacheRead":1.32,"cacheWrite":1.32}}]}}}
EOF
[ -f "$AGENT/settings.json" ] || printf '{"defaultProvider":"azet","defaultModel":"%s"}\n' "${AZET_MODEL:-deepseek-v4.1-flash}" > "$AGENT/settings.json"
# quietStartup true: Pi's own header never draws, not even when a signal ends the session (with "header" Pi redraws its logo on SIGTERM)
if grep -q '"quietStartup"' "$AGENT/settings.json"; then sed -i.bak 's/"quietStartup":[^,}]*/"quietStartup":true/' "$AGENT/settings.json"
else sed -i.bak 's/^{/{"quietStartup":true,/' "$AGENT/settings.json"; fi
rm -f "$AGENT/settings.json.bak"
# our header + ask-before-risky-commands gate, and our system prompt (both sit next to this script)
mkdir -p "$AGENT/extensions" && cp "${AZET_EXT:-$HERE/azet.ts}" "$AGENT/extensions/azet.ts"
cp "${AZET_SYSTEM:-$HERE/SYSTEM.md}" "$AGENT/SYSTEM.md"

# sandbox on by default: writes only inside the start folder (see sandbox.sb). --no-sandbox is ours, so drop it before the agent sees it.
SANDBOX="${AZET_SANDBOX:-1}"
for a; do shift; [ "$a" = --no-sandbox ] && { SANDBOX=0; continue; }; set -- "$@" "$a"; done
if [ "$SANDBOX" != 0 ] && [ -x /usr/bin/sandbox-exec ] && [ -f "$HERE/sandbox.sb" ]; then
  set -- /usr/bin/sandbox-exec -f "$HERE/sandbox.sb" -D WORK="$(pwd -P)" -D CFG="$(cd "$CFG" && pwd -P)" -D HOME="$(cd "$HOME" && pwd -P)" "$PI" "$@"
else
  SANDBOX=0; set -- "$PI" "$@"
fi

# PI_OFFLINE: no install report, version check or model-catalog fetch to pi.dev; model calls still go to api.azet.io
AZET_SANDBOX=$SANDBOX AZET_VERSION=$VERSION AZET_CODING_AGENT_DIR="$AGENT" PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0 exec "$@"
